#
# FanchmWrt 基础 .config（RK3399 / Rockchip armv8，ROCK DD 设备）
#
# 注意：
#   - 设备名 rock_rockdd 必须和 diy-part1.sh 里的 VENDOR/MODEL/BOARD_NAME 一致
#     （自动拼成 <vendor小写>_<board> = rock_rockdd）。
#   - 设备 DTS 会自动推导成 rockchip/rk3399-rockdd，无需在这里写。
#   - make defconfig 会自动补全依赖，这只是骨架。
#   - 想要最准的 .config：本地 clone fanchwrt/fanchmwrt，先手动跑一遍 diy-part1.sh 的逻辑
#     （放 dts、追加设备定义），再 make menuconfig 选好，把生成的 .config 覆盖回来。
#

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_rock_rockdd=y

CONFIG_DEVEL=y
CONFIG_HAVE_DOT_CONFIG=y

# ===== RTL8822BE (PCIe) WiFi 驱动 =====
CONFIG_PACKAGE_kmod-rtw88-8822be=y     # RTL8822BE 专用模块（会自动拉入 kmod-rtw88-8822b 公共模块）
CONFIG_PACKAGE_linux-firmware=y        # 提供 rtl8822be-firmware 固件
CONFIG_PACKAGE_wpad-basic-mbedtls=y    # Wi-Fi 加密（hostapd/wpa_supplicant）

# ===== 借用的 U-Boot（用于打包可刷 eMMC/SD 的 sysupgrade.img.gz）=====
# 此行会被 diy-part1.sh 按 UBOOT_PKG 自动同步：
#   rockpi4a  → u-boot-rock-pi-4-rk3399
#   rockpi4se → u-boot-rock-4se-rk3399
CONFIG_PACKAGE_u-boot-rock-pi-4-rk3399=y

# ===== LuCI 网页后台（强烈建议保留）=====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
